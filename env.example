# ===========================================
# Whisper-Input-Next 环境变量配置模板
# 复制为 .env 并填入你的实际配置： cp env.example .env
# ===========================================

# ===== 服务平台 =====
# 三处理器架构：OpenAI(批量) + 本地whisper.cpp + 豆包流式
SERVICE_PLATFORM=openai&local

# ===== Ctrl+F 转录服务选择 =====
# "doubao"（推荐，流式，边说边出字） 或 "openai"（GPT-4o transcribe 批量）
TRANSCRIPTION_SERVICE=doubao

# ===== 豆包流式 ASR（推荐，TRANSCRIPTION_SERVICE=doubao 时使用） =====
# 在火山引擎「语音技术」控制台开通「流式语音识别大模型(小时版)」后，
# 在应用的「服务接口认证信息」里获取（注意不是方舟 Ark 的 API Key）
DOUBAO_APP_KEY=your_volcengine_app_id
DOUBAO_ACCESS_KEY=your_volcengine_access_token

# ===== 本地 whisper.cpp（Ctrl+I / 离线免费） =====
# 需先自行编译 whisper.cpp 并下载模型，见 README
# CLI 用绝对路径；模型路径相对于 whisper.cpp 根目录
WHISPER_CLI_PATH=/path/to/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=models/ggml-large-v3-turbo.bin

# ===== 占位 key（程序启动时会无条件构造 OpenAI/Symbol/Kimi 对象，缺 key 会启动报错）=====
# 仅用本地+豆包时，这三个填任意占位值即可（构造不联网、不会真正调用）；
# 若要真用 OpenAI 转录/翻译，把 OFFICIAL_OPENAI_API_KEY 换成真实 key。
OFFICIAL_OPENAI_API_KEY=sk-placeholder-not-used
GROQ_API_KEY=gsk-placeholder-not-used
KIMI_API_KEY=kimi-placeholder-not-used

# ===== 键盘快捷键 =====
# Ctrl+<TRANSCRIPTIONS_BUTTON> = 豆包/OpenAI；Ctrl+<LOCAL_BUTTON> = 本地 whisper
# 默认 f / i；可自定义（如 x / z，避开与终端 Ctrl+Z 挂起冲突）
TRANSCRIPTIONS_BUTTON=f
TRANSLATIONS_BUTTON=ctrl
LOCAL_BUTTON=i
# 鼠标按键单独触发本地 Whisper（middle/left/right，留空禁用，默认禁用）
# 注：macOS 上 pynput 会把鼠标中键与拇指侧键都识别为 middle，
# 配 middle 则中键与侧键皆可触发；该监听不拦截按键原生行为
# （如浏览器中键开/关标签页仍会发生，文本框内一般无副作用）
MOUSE_BUTTON=
# 系统平台 (mac/win)
SYSTEM_PLATFORM=mac

# ===== 功能开关 =====
# 是否保存录音存档到 audio_archive/（默认 false，避免占满磁盘）
ENABLE_AUDIO_ARCHIVE=false
# 是否转换为简体中文
CONVERT_TO_SIMPLIFIED=false
# 是否自动添加标点符号
ADD_SYMBOL=false
# 是否优化结果
OPTIMIZE_RESULT=false
# 是否启用Kimi润色功能 (已废弃，推荐关闭)
ENABLE_KIMI_POLISH=false
# 自动重试次数（OpenAI/翻译）
AUTO_RETRY_LIMIT=5

# ===== 状态栏图标自定义（可选） =====
# STATUS_ICON_IDLE=/path/to/assets/icons/idle.png
# STATUS_ICON_RECORDING=/path/to/assets/icons/recording.png
# STATUS_ICON_PROCESSING=/path/to/assets/icons/transcripting.png
# STATUS_ICON_TEMPLATE=true

# ===== 兼容性配置（仅作兼容保留） =====
# SILICONFLOW_API_KEY=your-siliconflow-api-key-here
# KIMI_BASE_URL=https://api.moonshot.cn/v1
